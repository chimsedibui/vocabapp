{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VocabApp vocabulary import v1",
  "description": "Canonical content import after whitespace normalization. Approval and review history are never imported through this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deck_key",
          "deck_name",
          "term",
          "source_language",
          "target_language",
          "sense_key"
        ],
        "properties": {
          "deck_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "deck_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "not": {
              "const": "auto"
            }
          },
          "target_language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "not": {
              "const": "auto"
            }
          },
          "sense_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "meaning": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "part_of_speech": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "adverb",
              "pronoun",
              "preposition",
              "conjunction",
              "interjection",
              "determiner",
              "phrase",
              "other",
              null
            ]
          },
          "pronunciation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
